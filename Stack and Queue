VALID PARENTHESES

class Solution {
public:
    bool isValid(string s) {
        stack<char>st;
        for(int i=0;i<s.length();i++){
            char ch = s[i];
            // Opening bracket
            if(ch == '('|| ch =='{' || ch == '['){
                st.push(ch);
            }
            // For closing bracket
            else {
                if(!st.empty()){
                    char top = st.top();
                    // bracket maching 
                    if((ch ==')' && top == '(') || (ch == '}' && top == '{') || (ch == ']' && top == '[')){
                        st.pop();
                    }
                    else{
                        return false;
                    }
                }
                else{
                    return false;
                }
            }
        }
        if(st.empty()){
            return true;
        }
        else{
            return false;
        }
               
        
    }
};
