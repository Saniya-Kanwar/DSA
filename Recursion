SUM OF DIGITS USING RECURSION

#include <iostream>
using namespace std;

void solve(int n, int &sum)
{
  if(n == 0){
    return;
  }
  int rem = n%10;  // gives last digit
  sum += rem;
  solve(n/10,sum);   //removes last digit 
} 

int main() 
{
    int sum = 0;
    int n;
    cin>>n;
    solve(n,sum);
    cout<<sum;
    return 0;
}
