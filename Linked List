#include <iostream>
using namespace std;

class Node{
  public:
  int data;
  Node *next;
  
  Node(int value)
  {
    data = value;
    next = NULL;
  }
};
******************************************************************************
void insertAtStart(Node * &head, Node * &tail)
{
  if(head == NULL)
  {
    Node *n = new Node(2);
    head = n;
    tail = n;
  }
  else{
    Node *n =new Node(3);
    n->next = head;
    head = n;
  }
}
***********************************************************************************
void insertAtEnd(Node * &head, Node * &tail)
{
  if(head == NULL)
  {
    Node *n = new Node(2);
    head = n;
    tail = n;
  }
  else{
    Node *n =new Node(3);
    tail->next = n;
    tail = n;
  }
}
**************************************************************************************
void insertion(Node * &head, int posn)
{
  Node * temp = head;
  for(int i =1;i<posn -1;i++)
  {
    temp = temp->next;
  }
  Node * n = new Node(4);
  n->next = temp->next;
  temp->next = n;
}
****************************************************************************************
void deleteAtFirst(Node * &head, Node * &tail){
  Node * n = head->next;
  delete head;
  head = n;
}
***************************************************************************************
void deleteAtEnd(Node * &head , Node * &tail){
  Node *temp = head;
  while(temp->next != tail){
    temp = temp->next;
  }
  delete tail;
  temp->next =NULL;
  tail = temp;
}
***********************************************************************************
void display(Node * head){
  Node * temp = head;
  while(temp!= NULL){
    cout<<temp->data<<"->";
    temp= temp->next;
  }
  cout<<"NULL";
}
