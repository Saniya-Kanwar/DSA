BUBBLE SORT

#include <iostream>
using namespace std;

int main() 
{
    int n;
    cin>>n;
    int arr[n];
    for (int i=0;i<n;i++)
    {
      cin>>arr[i];
    }
    for (int i=0;i<n;i++)
    {
      for(int j =0;j<n-1;j++){
        if (arr[j] >arr[j+1]){
          swap(arr[j],arr[j+1]);
        }
      }
    }
    for (int i=0;i<n;i++)
    {
      cout<<arr[i]<<" ";
    }
    return 0;
}

*******************************************************************************************************************************************************************************************************************************************************************************
INSERTION SORT

#include <iostream>
using namespace std;

int main() 
{
    int n;
    cin>>n;
    int arr[n];
    for (int i=0;i<n;i++)
    {
      cin>>arr[i];
    }
    for (int i=0;i<n;i++)
    {
      for(int j =i;j>0;j--){
        if (arr[j] <arr[j-1]){
          swap(arr[j],arr[j-1]);
        }
      }
    }
    for (int i=0;i<n;i++)
    {
      cout<<arr[i]<<" ";
    }
    return 0;
}

***********************************************************************************************************************************************************************************************************
SELECTION SORT

#include <iostream>
using namespace std;

int main() 
{
    int n;
    cin>>n;
    int arr[n];
    for (int i=0;i<n;i++)
    {
      cin>>arr[i];
    }
    for (int i=0;i<n;i++)
    {
      int mei =i;                     // mei = minimum element index
      for(int j =i+1;j<n;j++)
      {
        if (arr[j] <arr[mei]){
          mei = j;
        }
      }
      swap(arr[i],arr[mei]);
    }
    for (int i=0;i<n;i++)
    {
      cout<<arr[i]<<" ";
    }
    return 0;
}

***************************************************************************************************************************************************************************************************************************************************************
REVERSE USING TWO POINTER APPROACH

#include <iostream>
using namespace std;

int main() 
{
    int n;
    cin>>n;
    int arr[n];
    for (int i=0;i<n;i++)
    {
      cin>>arr[i];
    }
    int i=0,j=n-1;
      while(i<j){
        swap(arr[i],arr[j]);
        i++,j--;
    }
    for (int i=0;i<n;i++)
    {
      cout<<arr[i]<<" ";
    }
    return 0;
}
*******************************************************************************************************************************************************************************************************************************************************************
SUM OF TWO NUMBERS IN AN ARRAY == TARGET

#include <iostream>
using namespace std;

int main() 
{
    int n;
    cin>>n;
    int arr[n];
    for (int i=0;i<n;i++)
    {
      cin>>arr[i];
    }
    int target;
    cin>>target;
    for(int i =0;i<n;i++){
      for(int j=i+1;j<n;j++)
      {
        if(arr[i] + arr[j] == target)
        {
          cout<<i<<" "<<j<<endl;
          break;
        }
      }
    }
    
    return 0;
}
