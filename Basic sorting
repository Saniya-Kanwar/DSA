2-D ARRAY : SUM

#include <iostream>
using namespace std;

int main() 
{
  int sum = 0;
    int arr[4][4];
    for(int i=0;i<4;i++){
      for(int j=0;j<4;j++)
      {
        cin>>arr[i][j];
      }
    }
    for(int i=0;i<4;i++){
      for(int j=0;j<4;j++)
      {
        cout<<arr[i][j]<<" ";
        sum += arr[i][j];
      }
      cout<<endl;
    }
    cout<<"sum is :"<<sum<<endl;
    return 0;
}
